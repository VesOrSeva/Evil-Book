    - rid: 8910043462656590015
      type: {class: 'Constant`1[[System.Int32, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: Unity.GraphToolkit.Internal.Editor}
      data:
        m_Value: 29
    - rid: 8910043462656590016
      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: Unity.GraphToolkit.Internal.Editor}
      data:
        m_Value: "I wish to confess that I do not write this without a semblance
          of guilt for my actions, but the Veil does teach us to seek knowledge,
          to elevate our minds, and I believe that my actions in their barest form
          abide by this teaching\u2026 Still may the Maker forgive me, for only he
          understands what needs to be done.\\n\\n  I broke into the Beacons Library
          a few hours ago. It was left not as well guarded as it usually is, with
          all the Keepers now tasked with collecting bodies. More specifically, I
          entered the inner chamber of the library,"
    - rid: 8910043462656590017
      type: {class: DefaultPage, ns: BookGraph.Editor, asm: Assembly-CSharp-Editor}
      data: 
    - rid: 8910043462656590023
      type: {class: UserNodeModelImp, ns: Unity.GraphToolkit.Editor.Implementation, asm: Unity.GraphToolkit.Editor}
      data:
        m_Guid:
          m_Value0: 10553813656755909127
          m_Value1: 7330030396182167168
        m_HashGuid:
          serializedVersion: 2
          Hash: 07329ab49aad769280fe4025cf7fb965
        m_Version: 2
        m_Position: {x: 6472, y: 267}
        m_Title: DefaultPage
        m_Tooltip: 
        m_NodePreviewModel:
          rid: -2
        m_State: 0
