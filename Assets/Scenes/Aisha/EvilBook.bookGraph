    - rid: 8910043595238277485
      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: Unity.GraphToolkit.Internal.Editor}
      data:
        m_Value: "You who has stolen viscera, meat and bone, stringing them together
          to make the fetid amalgamation you call a body.\\n\\n  I saw you\u2026
          Through the tear you beckon me to, a festering pulp of flesh. You disgusting
          thing. You are not human, you will never be human."
