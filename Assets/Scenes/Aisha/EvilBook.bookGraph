      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: Unity.GraphToolkit.Internal.Editor}
      data:
        m_Value: "or perhaps this is simply an old dead language.\\n\\n  Perhaps
          this was not the best choice, I came back with more questions than answers\u2026
          No, to solve, to know the answers will elevate my standing in the Veil.
          There must be something if this disease was of the Maker\u2019s time. May
          the Veil guide my eyes to see that which is hidden."
