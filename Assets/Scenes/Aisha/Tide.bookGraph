    - rid: 8910043736657100827
      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: Unity.GraphToolkit.Internal.Editor}
      data:
        m_Value: "There is only but one cure\u2026\\n\\n   I drowned in salt and
          water and I saw it.\\n\\n  In refractions. It called to me. The lines between
          us began to blur\u2026\\n\\n   It walked in my flesh when my mind rested,
          it wanted to take me somewhere. It wanted us to become one. It yearned
          so desperately for a body, I thought it pathetic.\\n\\n  "
    - rid: 8910043736657100828
      type: {class: DefaultPage, ns: BookGraph.Editor, asm: Assembly-CSharp-Editor}
