    - rid: 8910043736657100843
      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: Unity.GraphToolkit.Internal.Editor}
      data:
        m_Value: "You who has no identity, no soul.\\n\\n   You who has stolen viscera,
          meat and bone, stringing them together to make the fetid amalgamation you
          call a body.\\n\\n   I saw it\u2026\\n\\n   Then we became one.\\n\\n   
          And I was no more.\\n\\n"
    - rid: 8910043736657100844
      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: Unity.GraphToolkit.Internal.Editor}
      data:
        m_Value: 'There must be some other way! '
    - rid: 8910043736657100845
      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: Unity.GraphToolkit.Internal.Editor}
      data:
        m_Value: 'Where do I find water?! '
